# Local development defaults. Copy to .env; never commit real credentials.

# --- API ---
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
BODY_LIMIT=100kb
LOG_LEVEL=info
DATABASE_URL=postgres://cognitive_dag:local_dev_only@127.0.0.1:5433/cognitive_dag
VALKEY_URL=redis://127.0.0.1:6379
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cognitive-dag
FEATURE_FLAGS={"ping-enabled":true}

# --- Worker ---
WORKER_HEALTH_PORT=3001
# Artificial delay for the ping activity (ms). Ignored when NODE_ENV=production.
PING_ACTIVITY_DELAY_MS=0

# --- Web (Vite) ---
VITE_API_URL=http://localhost:3000

# --- Local infrastructure (compose.yaml) ---
POSTGRES_USER=cognitive_dag
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=cognitive_dag
# Host ports (5433 avoids clashing with a locally installed PostgreSQL)
POSTGRES_HOST_PORT=5433
VALKEY_HOST_PORT=6379
