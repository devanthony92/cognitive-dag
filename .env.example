# Local development defaults. Copy to .env; never commit real credentials.

# --- API ---
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
BODY_LIMIT=100kb
LOG_LEVEL=info
# The API connects only as app_runtime (no DELETE, no BYPASSRLS). Migrations run as app_migrator.
DATABASE_URL=postgres://app_runtime:app_runtime_dev_only@127.0.0.1:5433/cognitive_dag
DATABASE_MIGRATOR_URL=postgres://app_migrator:app_migrator_dev_only@127.0.0.1:5433/cognitive_dag
VALKEY_URL=redis://127.0.0.1:6379
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cognitive-dag
# Proxy hops whose X-Forwarded-For is believed: a closed list of addresses or CIDR ranges, comma
# separated. Empty (development) ignores the header. Production sets the network of the edge (Caddy).
TRUSTED_PROXIES=
# Product flags: none since F8 (ADR-0084). The catalog is empty; keep {} until a new flag exists.
FEATURE_FLAGS={}

# --- Mail (Mailpit in development: http://localhost:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# TLS of the SMTP connection: false (Mailpit), starttls (port 587) or true (implicit TLS, 465).
# Production refuses false and needs the login from the files SMTP_USER_FILE and SMTP_PASSWORD_FILE.
SMTP_SECURE=false
MAIL_FROM=CognitiveDAG <no-reply@cognitive-dag.localhost>
# Origin used to build the links inside emails (the web app).
APP_BASE_URL=http://localhost:5173
# Mailpit HTTP API, read by the integration tests only.
MAILPIT_URL=http://127.0.0.1:8025

# --- Worker ---
WORKER_HEALTH_PORT=3001
# The worker writes run records as app_runtime (same role as the API) and publishes live events to Valkey.
# It reads DATABASE_URL and VALKEY_URL from the API section above.
# Artificial delay for the ping activity (ms). Ignored when NODE_ENV=production.
PING_ACTIVITY_DELAY_MS=0
# Token bucket per organization and node type, e.g. RATE_LIMIT_MOCK_SERVICE for `mock.service`.
# Format: capacity:N,refillPerSecond:M. Without the variable, the node type has no limit.
# RATE_LIMIT_MOCK_SERVICE=capacity:10,refillPerSecond:5

# --- LLM nodes (F5) ---
# fake: deterministic, no network (default). gemini: needs GEMINI_API_KEY (real key only in your
# local .env, never committed). The free tier may use your content: test data only.
LLM_PROVIDER=fake
GEMINI_API_KEY=
# Kill switch: false makes every LLM activity fail with LLM_DISABLED without calling the provider.
LLM_ENABLED=true
LLM_MODEL_CLASSIFY=gemini-3.5-flash-lite
LLM_MODEL_EXTRACT=gemini-3.5-flash-lite
LLM_MODEL_GENERATE=gemini-3.5-flash-lite
# <model>:<input>:<output>; micro-USD per million tokens. A model without a price costs 0.
LLM_PRICES=gemini-3.5-flash-lite:300000:2500000;gemini-3.6-flash:1500000:7500000
LLM_MAX_TOKENS_PER_RUN=50000
# Read by the worker (enforces it) and the API (shows it).
LLM_MAX_TOKENS_PER_ORG_DAY=500000
LLM_MAX_INPUT_CHARS=20000
TEMPORAL_LLM_TASK_QUEUE=cognitive-dag-llm
LLM_MAX_CONCURRENT_ACTIVITIES=4
# Global token bucket per model (provider quota), shared by every organization.
RATE_LIMIT_LLM_MODEL=capacity:15,refillPerSecond:0.25

# --- NL → DAG compiler (F6) ---
LLM_MODEL_COMPILER=gemini-3.5-flash-lite
# Tokens of one compilation, repairs included (worker).
LLM_MAX_TOKENS_PER_COMPILATION=30000
# Compilations per person per hour and per organization per UTC day (API).
COMPILER_MAX_PER_USER_HOUR=10
COMPILER_MAX_PER_ORG_DAY=50

# --- Triggers, human control and HTTP (F7) ---
# Master key of the envelope encryption of connector credentials: base64 of 32 random bytes, read by
# the API and the worker. Generate one with `pnpm credentials:gen-key` and keep it only in your local
# .env. Required when NODE_ENV=production; without it the credential endpoints answer 503.
CREDENTIALS_MASTER_KEY=
# Kill switches of the worker: false skips schedule firings / fails HTTP nodes with HTTP_DISABLED.
TRIGGERS_ENABLED=true
HTTP_ENABLED=true
# Read by the API (hands it to the workflow) and the worker (listens on it).
TEMPORAL_HTTP_TASK_QUEUE=cognitive-dag-http
HTTP_MAX_CONCURRENT_ACTIVITIES=20
# Circuit breaker per organization and host: failures within the window open it; it waits the
# cooldown and a node waits at most HTTP_CB_MAX_WAIT_SECONDS before failing HTTP_CIRCUIT_OPEN.
HTTP_CB_FAILURES=5
HTTP_CB_WINDOW_SECONDS=60
HTTP_CB_COOLDOWN_SECONDS=30
HTTP_CB_MAX_WAIT_SECONDS=120
# How late a missed schedule firing may still run.
SCHEDULE_CATCHUP_WINDOW_SECONDS=3600
# Approval emails go to at most this many owners and editors (the database caps it at 20).
APPROVAL_EMAIL_MAX_RECIPIENTS=20
# Public origin of the API: base of the webhook URLs the UI shows (default http://localhost:API_PORT).
# API_PUBLIC_URL=https://api.example.com
# Public webhook: body cap in bytes and half-width of the X-Event-Timestamp window.
WEBHOOK_MAX_BODY_BYTES=65536
WEBHOOK_TIMESTAMP_WINDOW_SECONDS=300
# Tests only: lets the HTTP client reach loopback. The worker refuses to start in production if this
# variable is defined, so leave it out of every deployed environment.
# HTTP_TEST_ALLOW_LOOPBACK=true

# --- Web (Vite) ---
# Development: the API runs on its own port. A production build ignores this value and uses an empty
# one (same origin, relative /api/v1/... paths) unless VITE_API_URL is set in the build environment.
VITE_API_URL=http://localhost:3000
# Banner "demo sin copias de seguridad, solo datos de prueba". On by default in a production build;
# set false for a deployment that holds real data.
VITE_DEMO_NOTICE=false

# --- Local infrastructure (compose.yaml) ---
POSTGRES_USER=cognitive_dag
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=cognitive_dag
# Host ports (5433 avoids clashing with a locally installed PostgreSQL)
POSTGRES_HOST_PORT=5433
VALKEY_HOST_PORT=6379
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_HTTP_HOST_PORT=8025

# --- Production (F9) ---
# Names only; the values live in the secret store of the VM (specs/010-deployment/contracts/production-env.md).
# In production secrets are files mounted read only and the *_FILE variable points at each one:
#   CREDENTIALS_MASTER_KEY_FILE, GEMINI_API_KEY_FILE, DATABASE_PASSWORD_FILE, VALKEY_PASSWORD_FILE,
#   SMTP_USER_FILE, SMTP_PASSWORD_FILE
# TLS to the internal services (internal CA): DATABASE_URL with sslmode=verify-full and sslrootcert,
# VALKEY_URL with rediss://, VALKEY_USERNAME and VALKEY_CA_FILE, and for Temporal
#   TEMPORAL_TLS_CA_FILE, TEMPORAL_TLS_CERT_FILE, TEMPORAL_TLS_KEY_FILE, TEMPORAL_TLS_SERVER_NAME
# WEB_ORIGIN and API_PUBLIC_URL must be https://. The service refuses to start otherwise and names
# only the variables at fault.
