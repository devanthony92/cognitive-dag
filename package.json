{
  "name": "cognitive-dag",
  "version": "0.0.0",
  "private": true,
  "description": "AI workflow orchestrator: natural language compiled into durable, fault-tolerant DAGs",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @cognitive-dag/db generate",
    "db:migrate": "pnpm --filter @cognitive-dag/db migrate",
    "security:evidence": "node scripts/security/check-evidence.ts",
    "credentials:gen-key": "node scripts/credentials-gen-key.ts",
    "ops:set-limits": "turbo run build --filter=@cognitive-dag/scripts^... && node scripts/ops/set-limits.ts",
    "test:chaos": "turbo run test:chaos --concurrency=1",
    "eval:llm": "turbo run build --filter=@cognitive-dag/scripts^... && node scripts/eval/llm.ts",
    "eval:compiler": "turbo run build --filter=@cognitive-dag/scripts^... && node scripts/eval/compiler.ts",
    "demo:recovery": "turbo run build --filter=@cognitive-dag/scripts^... --filter=@cognitive-dag/worker && node scripts/demo/recovery.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
