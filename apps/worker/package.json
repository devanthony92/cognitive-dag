{
  "name": "@cognitive-dag/worker",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit test/workflows",
    "test:integration": "vitest run test/integration test/replay test/compiler test/http test/approvals test/schedules test/no-content.test.ts",
    "test:chaos": "vitest run --config vitest.chaos.config.ts"
  },
  "dependencies": {
    "@cognitive-dag/compiler": "workspace:*",
    "@cognitive-dag/connectors": "workspace:*",
    "@cognitive-dag/contracts": "workspace:*",
    "@cognitive-dag/dag-schema": "workspace:*",
    "@cognitive-dag/db": "workspace:*",
    "@cognitive-dag/llm": "workspace:*",
    "@cognitive-dag/logger": "workspace:*",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "iovalkey": "0.4.0",
    "nodemailer": "10.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cognitive-dag/config": "workspace:*",
    "@temporalio/testing": "1.25.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
