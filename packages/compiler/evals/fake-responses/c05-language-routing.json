[
  {
    "title": "Enrutar por idioma",
    "nodes": [
      {
        "id": "start",
        "type": "trigger.manual",
        "label": "Inicio",
        "config": {
          "inputSchema": [
            {
              "name": "message",
              "type": {
                "kind": "string"
              }
            }
          ]
        }
      },
      {
        "id": "classify",
        "type": "llm.classify",
        "label": "Clasificar",
        "config": {
          "text": "{{nodes.start.output.message}}",
          "labels": ["es", "en"]
        }
      },
      {
        "id": "check",
        "type": "logic.condition",
        "label": "Revisar etiqueta",
        "config": {
          "condition": {
            "op": "eq",
            "left": {
              "kind": "ref",
              "path": "nodes.classify.output.label"
            },
            "right": {
              "kind": "literal",
              "type": "string",
              "value": "es"
            }
          }
        }
      },
      {
        "id": "yes",
        "type": "mock.service",
        "label": "Equipo de espanol",
        "config": {
          "latencyMs": 100,
          "failureRate": 0,
          "failureKind": "transient"
        }
      },
      {
        "id": "no",
        "type": "mock.service",
        "label": "Equipo de ingles",
        "config": {
          "latencyMs": 100,
          "failureRate": 0,
          "failureKind": "transient"
        }
      }
    ],
    "edges": [
      {
        "from": "start",
        "fromHandle": "out",
        "to": "classify"
      },
      {
        "from": "classify",
        "fromHandle": "out",
        "to": "check"
      },
      {
        "from": "check",
        "fromHandle": "true",
        "to": "yes"
      },
      {
        "from": "check",
        "fromHandle": "false",
        "to": "no"
      }
    ]
  }
]
