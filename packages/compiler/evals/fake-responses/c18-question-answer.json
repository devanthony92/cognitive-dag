[
  {
    "title": "Responder preguntas",
    "nodes": [
      {
        "id": "start",
        "type": "trigger.manual",
        "label": "Inicio",
        "config": {
          "inputSchema": [
            {
              "name": "email_body",
              "type": {
                "kind": "string"
              }
            }
          ]
        }
      },
      {
        "id": "classify",
        "type": "llm.classify",
        "label": "Clasificar",
        "config": {
          "text": "{{nodes.start.output.email_body}}",
          "labels": ["pregunta", "otro"]
        }
      },
      {
        "id": "check",
        "type": "logic.condition",
        "label": "Revisar etiqueta",
        "config": {
          "condition": {
            "op": "eq",
            "left": {
              "kind": "ref",
              "path": "nodes.classify.output.label"
            },
            "right": {
              "kind": "literal",
              "type": "string",
              "value": "pregunta"
            }
          }
        }
      },
      {
        "id": "write",
        "type": "llm.generate",
        "label": "Generar texto",
        "config": {
          "instruction": "Responde esta pregunta: {{nodes.start.output.email_body}}",
          "language": "es",
          "maxLength": 500
        }
      },
      {
        "id": "send",
        "type": "mock.service",
        "label": "Enviar respuesta",
        "config": {
          "latencyMs": 100,
          "failureRate": 0,
          "failureKind": "transient"
        }
      },
      {
        "id": "other",
        "type": "mock.service",
        "label": "Marcar como leido",
        "config": {
          "latencyMs": 100,
          "failureRate": 0,
          "failureKind": "transient"
        }
      }
    ],
    "edges": [
      {
        "from": "start",
        "fromHandle": "out",
        "to": "classify"
      },
      {
        "from": "classify",
        "fromHandle": "out",
        "to": "check"
      },
      {
        "from": "check",
        "fromHandle": "true",
        "to": "write"
      },
      {
        "from": "write",
        "fromHandle": "out",
        "to": "send"
      },
      {
        "from": "check",
        "fromHandle": "false",
        "to": "other"
      }
    ]
  }
]
