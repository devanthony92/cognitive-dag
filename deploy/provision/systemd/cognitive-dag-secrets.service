[Unit]
Description=Fetch the CognitiveDAG secrets from OCI Vault into a tmpfs
Documentation=https://github.com/devanthony92/cognitive-dag/blob/main/docs/operations/secrets.md
After=network-online.target
Wants=network-online.target
Before=cognitive-dag.service

[Service]
Type=oneshot
RemainAfterExit=yes
# /run is a tmpfs: the secrets and the internal certificates never reach the disk.
RuntimeDirectory=cognitive-dag
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/opt/cognitive-dag/deploy/provision/secrets.sh fetch
TimeoutStartSec=180
# Fail closed: no secrets, no stack. A late network is retried, never skipped.
Restart=on-failure
RestartSec=30
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
