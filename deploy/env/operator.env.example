# Environment of the operator machine for `deploy/provision/secrets.sh init-generated | put | list`.
# Names and origin only. The operator uses their own OCI CLI profile (`oci setup config`).

# OCID of the Vault. Origin: Oracle console.
VAULT_OCID=
# OCID of the compartment that holds the Vault and its secrets.
OCI_COMPARTMENT_OCID=
# OCID of the Vault master encryption key that protects the secrets.
OCI_VAULT_KEY_OCID=
