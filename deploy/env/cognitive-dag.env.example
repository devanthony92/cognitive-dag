# Constants of the deployment: /etc/cognitive-dag/cognitive-dag.env on the VM, written by cloud-init
# (deploy/provision/cloud-init.yaml). Names and origin only; none of these is a secret. A value set in
# the environment of a script wins over this file. Compose reads this file with --env-file.

# Oracle region of the tenancy.
OCI_REGION=
# OCID of the Vault with the secrets (Oracle console > Identity & Security > Vault).
VAULT_OCID=
# Registry and namespace of the images (the same values as the repository variables of the release).
OCIR_REGISTRY=
OCIR_NAMESPACE=
# Read-only registry user; its token is the Vault secret cdag-ocir_pull_token.
OCIR_PULL_USER=
# OCI Email Delivery relay (SMTP endpoint of the region), STARTTLS on 587, and the approved sender.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
MAIL_FROM=
