# Operator configuration of this VM: /etc/cognitive-dag/local.env, created by hand on the VM. It is not
# in the repository and is never committed; names and origin only here.

# Public domain of the site (the A record points at the VM). Origin: the operator.
SITE_DOMAIN=
# Where the alerts are mailed. Origin: the operator; a personal address, so it stays on the VM.
ALERT_EMAIL_TO=

# Optional. Alert thresholds (defaults in deploy/ops/alerts.sh).
# ALERT_AUTH_THRESHOLD=
# ALERT_WINDOW_MINUTES=
# ALERT_DISK_PERCENT=
# ALERT_CERT_MIN_DAYS=
# ALERT_COOLDOWN_MINUTES=

# Optional. Kill switches of the worker (docs/operations/kill-switches.md); true by default.
# LLM_ENABLED=
# TRIGGERS_ENABLED=
# HTTP_ENABLED=
